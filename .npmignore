/.env
/reports/
/projects/
/tests/
/backend/logs/
/backend/.plum-jobs/
*.log
.plum/
.plum-node.json
.plum-server.json
.runners.local.json
docker-compose.override.yml
backend/reports/
backend/tests/
backend/.env

# Build output, regenerated on install
frontend/build/
frontend/.svelte-kit/

# Node dependencies (installed fresh on the user's machine)
node_modules/
backend/node_modules/
frontend/node_modules/
