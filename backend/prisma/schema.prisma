generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Runner {
  id        String    @id @default(cuid())
  name      String
  url       String
  token     String
  browser   String    @default("chromium")
  createdAt DateTime  @default(now())
  cronJobs  CronJob[]
  reports   Report[]
}

model CronJob {
  id             Int      @id @default(autoincrement())
  projectId      Int
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskName       String
  cronExpression String
  tags           String
  workers        Int      @default(1)
  browser        String   @default("chromium")
  enabled        Boolean  @default(true)
  runnerId       String?
  runnerIds      String   @default("built-in")
  notifyDiscord  Boolean  @default(false)
  notifySlack    Boolean  @default(false)
  runner         Runner?  @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reports        Report[]

  @@unique([projectId, taskName])
  @@index([projectId])
}

model Report {
  id          Int               @id @default(autoincrement())
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      String
  tags        String
  triggerType String            @default("manual-trigger")
  // runnerCount = distinct runner machines/lanes in this run (built-in counts as one).
  // workerCount = Cucumber --parallel workers within each runner. Two independent
  // axes of parallelism — kept as separate columns since one DB column used to mean
  // one or the other depending on which code path wrote it.
  runnerCount Int               @default(1)
  workerCount Int               @default(1)
  browser     String            @default("chromium")
  runnerName  String?
  runnerId    String?
  runner      Runner?           @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  cronJobId   Int?
  cronJob     CronJob?          @relation(fields: [cronJobId], references: [id], onDelete: SetNull)
  testRunId   String?
  testRun     TestRun?          @relation(fields: [testRunId], references: [id], onDelete: SetNull)
  content     Json
  logs        String?
  duration    Int?
  createdAt   DateTime          @default(now())
  testHistory TestCaseHistory[]
  recordings  Recording[]

  @@index([createdAt])
  @@index([status])
  @@index([testRunId])
  @@index([runnerId])
  @@index([cronJobId])
  @@index([projectId])
}

// One row per (report, scenario, worker, browser tab) — a scenario that opens
// extra tabs, or runs under a multi-worker runner, produces multiple rows.
// `events` is a gzip-compressed JSON array of rrweb events.
model Recording {
  id         Int      @id @default(autoincrement())
  reportId   Int
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  scenarioId String
  workerId   Int      @default(1)
  tabId      String   @default("main")
  tabIndex   Int      @default(0)
  // Epoch ms of this tab's first/last recorded event — lets the replay UI line
  // multiple tabs up on one absolute timeline and auto-switch between them.
  // Null on recordings written before this field existed.
  startedAt  BigInt?
  endedAt    BigInt?
  events     Bytes
  createdAt  DateTime @default(now())

  @@index([reportId])
  @@index([reportId, scenarioId])
}

model Organization {
  id        Int       @id @default(autoincrement())
  name      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id                   Int          @id @default(autoincrement())
  orgId                Int
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug                 String       @unique
  name                 String       @default("")
  baseUrl              String       @default("")
  logoUrl              String       @default("")
  timezone             String       @default("UTC")
  testCasePrefix       String       @default("TC")
  testSuitePrefix      String       @default("TS")
  caseSeqNext          Int          @default(0)
  suiteSeqNext         Int          @default(0)
  discordWebhookUrl    String       @default("")
  slackWebhookUrl      String       @default("")
  notifyPublicUrl      String       @default("")
  backupEnabled        Boolean      @default(false)
  backupCron           String       @default("0 2 * * *")
  backupS3Endpoint     String       @default("")
  backupS3Region       String       @default("")
  backupS3Bucket       String       @default("")
  backupS3AccessKey    String       @default("")
  backupS3SecretKey    String       @default("")
  backupS3Prefix       String       @default("")
  backupLastRunAt      DateTime?
  backupLastStatus     String       @default("")
  backupIncludeReports Boolean      @default(false)
  mcpKey               String       @default("")
  maxRetries           Int          @default(0)

  members  ProjectMember[]
  suites   TestSuite[]
  cases    TestCase[]
  runs     TestRun[]
  reports  Report[]
  cronJobs CronJob[]
  runQueue RunQueue[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  suites             TestSuite[]
  cases              TestCase[]
  runs               TestRun[]
  executedEntries    TestRunEntry[]    @relation("entryExecutor")
  assignedEntries    TestRunEntry[]    @relation("entryAssignee")
  caseHistories      TestCaseHistory[]
  projectMemberships ProjectMember[]
}

model TestSuite {
  id          String     @id @default(cuid())
  projectId   Int
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  displayId   String
  name        String
  description String     @default("")
  priority    String     @default("Medium")
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cases       TestCase[]

  @@unique([projectId, displayId])
  @@index([createdAt])
  @@index([projectId])
}

model TestCase {
  id          String            @id @default(cuid())
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  displayId   String
  title       String
  description String            @default("")
  priority    String            @default("Medium")
  isAutomated Boolean           @default(false)
  suiteId     String
  suite       TestSuite         @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  steps       TestStep[]
  runEntries  TestRunEntry[]
  history     TestCaseHistory[]

  @@unique([projectId, displayId])
  @@index([suiteId])
  @@index([projectId])
}

model TestStep {
  id             String   @id @default(cuid())
  caseId         String
  case           TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action         String
  testData       String   @default("")
  expectedOutput String   @default("")
  order          Int
  createdAt      DateTime @default(now())
}

model TestRun {
  id          String            @id @default(cuid())
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  status      String            @default("backlog")
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  entries     TestRunEntry[]
  history     TestCaseHistory[]
  reports     Report[]

  @@index([createdAt])
  @@index([projectId])
}

model TestRunEntry {
  id           String    @id @default(cuid())
  runId        String
  run          TestRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId       String
  case         TestCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status       String    @default("pending")
  notes        String    @default("")
  order        Int       @default(0)
  executedById String?
  executedBy   User?     @relation("entryExecutor", fields: [executedById], references: [id])
  executedAt   DateTime?
  assignedToId String?
  assignedTo   User?     @relation("entryAssignee", fields: [assignedToId], references: [id])

  @@index([runId])
  @@index([caseId])
}

// One row per run request (manual, cron, external, mcp). A run stays `queued`
// until every runner it targets is free, then flips to `running`, then `done`.
// DB-backed so the queue survives a restart — stale `running` rows are
// reconciled to `done` on boot and queued rows resume.
model RunQueue {
  id            String    @id
  projectId     Int
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          String
  triggerType   String    @default("manual-trigger")
  label         String    @default("")
  status        String    @default("queued")
  tag           String    @default("")
  workers       Int       @default(1)
  browser       String    @default("chromium")
  runnerIds     String    @default("built-in")
  testRunId     String?
  baseUrl       String?
  runTitle      String?
  startedBy     String?
  notifyDiscord Boolean   @default(false)
  notifySlack   Boolean   @default(false)
  reportId      Int?
  exitCode      Int?
  note          String?
  queuedAt      DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([status, queuedAt])
  @@index([projectId])
}

model TestCaseHistory {
  id           String   @id @default(cuid())
  caseId       String
  case         TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  runId        String?
  run          TestRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  reportId     Int?
  report       Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  result       String
  source       String   @default("manual")
  notes        String   @default("")
  executedById String?
  executedBy   User?    @relation(fields: [executedById], references: [id])
  executedAt   DateTime @default(now())

  @@index([caseId])
  @@index([runId])
  @@index([reportId])
}
