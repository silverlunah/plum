{
	"license": "./resources/mit-license.txt",
	"ignoreDefaultIgnores": false,
	"licenseFormats": {
		"js|cjs|ts|mjs|css": {
			"prepend": "/*",
			"append": " */\n",
			"eachLine": {
				"prepend": " * "
			}
		},
		"svelte": {
			"prepend": "<!--",
			"append": " -->\n",
			"eachLine": {
				"prepend": " * "
			}
		},
		"dotfile|^Dockerfile|yml|yaml|prettierignore|gitignore|env|example": {
			"prepend": "#",
			"append": "#\n",
			"eachLine": {
				"prepend": "# "
			}
		}
	},
	"trailingWhitespace": "TRIM",
	"ignore": [
		"**/backend/tests/**",
		"**/backend/_scaffold/**",
		"**/projects/**",
		"**/.prettierrc",
		"**/.husky",
		"**/*.md",
		"**/*.feature",
		"**/prisma/migrations/**",
		"**/prisma/schema.prisma",
		"**/.npmignore",
		"**/.npmrc",
		"**/.svelte-kit/**",
		"**/build/**",
		"**/reports/**",
		"**/logs/**",
		"**/.plum-jobs/**",
		"**/node_modules/**"
	]
}
