{
	"name": "plum-e2e",
	"version": "3.2.8",
	"repository": {
		"type": "git",
		"url": "https://github.com/silverlunah/plum.git"
	},
	"engines": {
		"node": ">=22.22.1"
	},
	"description": "Self-hosted QA platform for teams doing manual and automated testing. Comes with a full test-case repository alongside a ready-to-use Playwright or Cucumber test automation environment.",
	"main": "index.js",
	"scripts": {
		"init": "npm install && npm --prefix backend install && npm --prefix backend run init && npm --prefix frontend install && node bin/scaffold-tests.js",
		"format": "prettier --write .",
		"add-license": "npx license-check-and-add add -f license-config.json",
		"prepare": "husky",
		"postinstall": "node bin/postinstall.js",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"nodes:up": "node scripts/nodes.cjs up",
		"nodes:down": "node scripts/nodes.cjs down",
		"nodes:list": "node scripts/nodes.cjs list",
		"cli:test": "node scripts/cli-test.cjs",
		"cli:test:full": "node scripts/cli-test.cjs --full"
	},
	"keywords": [],
	"bin": {
		"plum": "./bin/plum.js"
	},
	"author": "silverlunah",
	"license": "MIT",
	"devDependencies": {
		"husky": "^9.1.7",
		"license-check-and-add": "^4.0.5",
		"lint-staged": "^17.0.7",
		"prettier": "^3.5.1",
		"prettier-plugin-svelte": "^3.3.3"
	},
	"dependencies": {
		"@clack/prompts": "^1.5.1",
		"fs-extra": "^11.3.0",
		"picocolors": "^1.1.1"
	},
	"type": "module",
	"lint-staged": {
		"*.{js,ts,mjs,svelte,json,md,css,html}": "prettier --write"
	}
}
